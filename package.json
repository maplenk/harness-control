{
  "name": "harness-orchestration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI-first, capability-driven orchestration across coding-agent harnesses.",
  "bin": {
    "harness-orchestrator": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "profiles",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "smoke:claude:provider": "tsx scripts/claude-provider-live-smoke.ts",
    "smoke:claude:provider:record": "tsx scripts/claude-provider-live-smoke.ts --record-evidence",
    "smoke:opencode:isolation": "tsx scripts/opencode-isolation-smoke.ts",
    "smoke:opencode:isolation:record": "tsx scripts/opencode-isolation-smoke.ts --record-evidence",
    "smoke:grok:isolation": "tsx scripts/grok-build-isolation-smoke.ts",
    "smoke:grok:isolation:record": "tsx scripts/grok-build-isolation-smoke.ts --record-evidence",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "smoke:live:chat": "tsx scripts/live-smoke.ts --chat"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.59.0",
    "@agentclientprotocol/codex-acp": "1.1.4",
    "@agentclientprotocol/sdk": "1.2.1",
    "better-sqlite3": "12.11.1",
    "opencode-ai": "1.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
